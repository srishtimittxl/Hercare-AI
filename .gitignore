# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# Dependencies & Virtual Environments
node_modules/
**/node_modules/
.venv/
venv/
**/.venv/
**/venv/
artifacts/hercare/backend/.venv/

# Environment variables & secrets (keep .env.example trackable)
.env
.env*
**/.env
**/.env*
!.env.example
!**/.env.example

# Python bytecode & cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Downloaded NLTK corpora (auto-downloaded on startup)
nltk_data/
**/nltk_data/
artifacts/hercare/backend/nltk_data/

# SQLite databases & WAL/SHM runtime files
*.db
*.db-shm
*.db-wal
**/*.db
**/*.db-shm
**/*.db-wal

# Archive files
*.zip
**/*.zip

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Misc logs & coverage
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
**/.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

interview_prep_guide.md
