# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (never commit API keys or secrets)
.env
.env*
!.env.example
!backend/.env.example
backend/.env
backend/.env*

# Python backend virtual environment, cache, NLTK downloads & local SQLite runtime files
.venv/
venv/
backend/.venv/
backend/venv/
backend/__pycache__/
**/__pycache__/
*.pyc
backend/nltk_data/
**/nltk_data/
*.db
*.db-shm
*.db-wal
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# Archives
*.zip

# typescript
*.tsbuildinfo
.vercel