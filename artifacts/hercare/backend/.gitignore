# Never commit environment variables or API keys
.env
.env*
!.env.example

# Python virtual environment & bytecode cache
.venv/
venv/
__pycache__/
*.pyc

# Downloaded NLTK corpora (auto-downloaded at runtime)
nltk_data/

# SQLite database & temporary files (auto-created at runtime)
*.db
*.db-shm
*.db-wal
data/*.db
data/*.db-shm
data/*.db-wal

# Archives
*.zip
